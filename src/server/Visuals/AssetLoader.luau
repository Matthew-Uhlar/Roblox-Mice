--!strict
-- AssetLoader (R4 Graphics): loads generated mesh assets for the client renderers.
--
--   AssetLoader.preload()   idempotent; starts loading in the background.
--
-- Shared.Config.AssetIds (generated by scripts/publish.py from
-- assets/models/manifest.json) maps a manifest name to a Roblox asset id. The
-- uploads are type "Model" (.fbx/.glb import as a Model of MeshParts), so they are
-- loaded with InsertService:LoadAsset on the SERVER (MeshPart.MeshId cannot be set
-- by scripts at run time: its write security is NotAccessible). Each loaded model
-- is stored as ReplicatedStorage.TrunkfallAssets.<manifest name>; the client
-- (src/client/Visuals/Assets) clones it and falls back to part models while the
-- template is missing.
--
-- Manifest naming convention (assets/models/PLAN.md): "hero_elephant",
-- "mouse_<enemyId>" (mouse_mouse, mouse_rat_runner, ...) and "boss_<bossId>".
-- InsertService can only load assets owned by the game's creator (or Roblox).

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AssetLoader = {}

AssetLoader.FOLDER = "TrunkfallAssets"

local started = false

local function assetIds(): { [string]: number }
	local ok, mod = pcall(function()
		local config = ReplicatedStorage:WaitForChild("Shared"):FindFirstChild("Config")
		local inst = config and config:FindFirstChild("AssetIds")
		return if inst and inst:IsA("ModuleScript") then require(inst) :: any else nil
	end)
	if ok and type(mod) == "table" then
		return mod
	end
	return {}
end

local function prepare(model: Instance)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy() -- never run code that came with an asset
		end
	end
end

function AssetLoader.preload()
	if started then
		return
	end
	started = true
	local ids = assetIds()
	if next(ids) == nil then
		return
	end
	local folder = ReplicatedStorage:FindFirstChild(AssetLoader.FOLDER)
	if not folder then
		local f = Instance.new("Folder")
		f.Name = AssetLoader.FOLDER
		f.Parent = ReplicatedStorage
		folder = f
	end
	for name, id in ids do
		if type(id) ~= "number" or id <= 0 then
			continue
		end
		task.spawn(function()
			local ok, loaded = pcall(function()
				return InsertService:LoadAsset(id)
			end)
			if not ok or not loaded then
				warn(
					"[AssetLoader] could not load "
						.. name
						.. " ("
						.. tostring(id)
						.. "): "
						.. tostring(loaded)
				)
				return
			end
			local root: Instance = loaded
			local kids = loaded:GetChildren()
			if #kids == 1 and kids[1]:IsA("Model") then
				root = kids[1]
			end
			root.Name = name
			prepare(root)
			if root:IsA("Model") and not root.PrimaryPart then
				root.PrimaryPart = root:FindFirstChildWhichIsA("BasePart", true)
			end
			root.Parent = folder
			if root ~= loaded then
				loaded:Destroy()
			end
		end)
	end
end

return AssetLoader
