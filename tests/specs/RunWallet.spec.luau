--!strict
-- Run/RunWallet: v5 in-run economy (docs/V5-PLAN.md §A, iteration-1 PLAN §D).
local T = require("../lib/Test")
local RunWallet = require("../../src/shared/Run/RunWallet")
local Rng = require("../../src/shared/Util/Rng")

local Shop = RunWallet.Shop

T.describe("RunWallet", function()
	T.it("rinds: Config/RunShop rates scaled by stage; 1 whey per 25 rinds; Greed x1.3", function()
		for _, kind in { "mouse", "elite", "champion", "boss" } do
			T.near(RunWallet.rindsFor(kind, 1), Shop.RINDS[kind], 1e-9, kind)
		end
		T.near(RunWallet.rindsFor("mouse", 3), Shop.RINDS.mouse * (1 + 2 * Shop.STAGE_SCALE), 1e-9)
		local w = RunWallet.new()
		local r, wh = RunWallet.earnRinds(w, 60)
		T.eq(r, 60)
		T.eq(wh, math.floor(60 / Shop.WHEY_PER_RINDS))
		T.eq(w.whey, wh)
		RunWallet.earnWhey(w, 300)
		T.truthy(RunWallet.buyBuff(w, "greed"))
		T.near(RunWallet.rindMult(w), 1.3)
		local r2 = RunWallet.earnRinds(w, 100, RunWallet.rindMult(w))
		T.near(r2, 130)
	end)
	T.it("stat ranks: ceil(base * 1.14^rank), max 25, kept on knockout", function()
		local w = RunWallet.new()
		RunWallet.earnRinds(w, 100000)
		T.eq(RunWallet.rankCost("might", 0), 20)
		T.eq(RunWallet.rankCost("might", 1), math.ceil(20 * 1.14))
		for _ = 1, 25 do
			T.truthy(RunWallet.buyRank(w, "might"))
		end
		local ok, why = RunWallet.buyRank(w, "might")
		T.falsy(ok)
		T.eq(why, "max")
		T.eq(select(2, RunWallet.buyRank(w, "nope")), "unknown")
		RunWallet.knockout(w)
		T.eq(w.ranks.might, 25)
		local poor = RunWallet.new()
		T.eq(select(2, RunWallet.buyRank(poor, "hide")), "funds")
	end)
	T.it("stall buffs: 250 whey once per life, offer-checked; class buff 500; lost on knockout", function()
		local w = RunWallet.new()
		RunWallet.earnWhey(w, 1000)
		T.eq(select(2, RunWallet.buyBuff(w, "rush", { "keen", "leech" })), "offer")
		T.truthy(RunWallet.buyBuff(w, "rush", { "rush", "keen" }))
		T.eq(select(2, RunWallet.buyBuff(w, "rush")), "owned")
		T.truthy(RunWallet.buyBuff(w, "class"))
		T.eq(w.whey, 1000 - Shop.BUFF_COST - Shop.CLASS_BUFF_COST)
		local lost = RunWallet.knockout(w)
		T.eq(#lost, 2)
		T.eq(#w.buffs, 0)
		T.truthy(RunWallet.buyBuff(w, "rush"), "buyable again in the next life")
	end)
	T.it("ultimates: stage 3+, 6000 rinds + 600 whey, at most 2", function()
		local w = RunWallet.new()
		RunWallet.earnRinds(w, 20000)
		RunWallet.earnWhey(w, 2000)
		T.eq(select(2, RunWallet.buyUltimate(w, "titan", 2)), "stage")
		T.truthy(RunWallet.buyUltimate(w, "titan", 3))
		T.eq(select(2, RunWallet.buyUltimate(w, "titan", 3)), "owned")
		T.truthy(RunWallet.buyUltimate(w, "overdrive", 3))
		T.eq(select(2, RunWallet.buyUltimate(w, "cataclysm", 4)), "max")
		T.eq(#RunWallet.knockout(w), 2)
	end)
	T.it("swap: rinds -> whey only at Config/RunShop's rate (iteration 3: 5:1, no fee)", function()
		local w = RunWallet.new()
		RunWallet.earnRinds(w, 100)
		local wheyBefore = w.whey
		local got, spent = RunWallet.swapToWhey(w, 50)
		local want = math.floor(50 / Shop.SWAP_RATE * (1 - Shop.SWAP_FEE))
		T.eq(got, want)
		T.eq(spent, math.ceil(want * Shop.SWAP_RATE / (1 - Shop.SWAP_FEE)))
		T.eq(w.whey, wheyBefore + want)
		T.eq(w.rinds, 100 - spent)
		T.eq((RunWallet.swapToWhey(w, Shop.SWAP_RATE - 1)), 0, "not enough for one whey")
		T.eq((RunWallet.swapToWhey(w, 0)), 0)
	end)
	T.it("deltas: ranks, buffs, class buff and ultimates combine; caps hold", function()
		local w = RunWallet.new()
		RunWallet.earnRinds(w, 10000000)
		RunWallet.earnWhey(w, 10000)
		for _ = 1, 25 do
			RunWallet.buyRank(w, "stride")
			RunWallet.buyRank(w, "focus")
		end
		RunWallet.buyRank(w, "plating")
		RunWallet.buyBuff(w, "class")
		RunWallet.buyUltimate(w, "titan", 4)
		local d = RunWallet.deltas(w, "elephante")
		local want = Shop.combine(w.ranks, {}, { "titan" }, "elephante", true)
		T.deepEq(d, want, "the same layer as Config/RunShop.combine")
		T.truthy((d.add :: any).armor >= 2, "plating + the class buff")
		local v = RunWallet.view(w)
		T.eq(v.ranks.stride, 25)
		T.deepEq(v.ultimates, { "titan" })
	end)
	T.it("layout: 5 stalls on the 0.55 R ring + a class stall; altar and swap at the centre", function()
		local stalls, altar, swap = RunWallet.layout(Rng.new(3), 400, 10, -5)
		T.eq(#stalls, RunWallet.STALL_COUNT + 1)
		for i = 1, RunWallet.STALL_COUNT do
			local s = stalls[i]
			T.near(math.sqrt((s.x - 10) ^ 2 + (s.z + 5) ^ 2), 220, 1e-6)
			T.eq(#s.offers, 2)
			T.truthy(s.offers[1] ~= s.offers[2])
		end
		T.eq(stalls[#stalls].class, true)
		T.eq(altar.x, 10)
		T.eq(swap.z, -5)
		local again = RunWallet.layout(Rng.new(3), 400, 10, -5)
		T.deepEq(again[1].offers, stalls[1].offers, "deterministic")
	end)
end)

return T.finish()
