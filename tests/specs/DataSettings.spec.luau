--!strict
-- Data/Settings (iter 5 #3): SetSetting keys and values (saved graphics settings).
local T = require("../lib/Test")
local Settings = require("../../src/shared/Data/Settings")
local ProfileSchema = require("../../src/shared/Data/ProfileSchema")

T.describe("Data/Settings", function()
	T.it("boolean keys take booleans only", function()
		T.eq(select(2, Settings.validate("hints", true)), true)
		T.eq((Settings.validate("hints", false)), true)
		T.eq((Settings.validate("hints", "full")), false)
		T.eq((Settings.validate("music", 1)), false)
		T.eq((Settings.validate("notAKey", true)), false)
		T.eq((Settings.validate(nil, true)), false)
	end)
	T.it("fx = full | reduced | off; decor = full | low; full is stored as nil", function()
		local ok, v = Settings.validate("fx", "reduced")
		T.eq(ok, true)
		T.eq(v, "reduced")
		T.eq(select(2, Settings.validate("fx", "off")), "off")
		ok, v = Settings.validate("fx", "full")
		T.eq(ok, true)
		T.eq(v, nil, "default -> nil")
		T.eq(select(2, Settings.validate("decor", "low")), "low")
		T.eq((Settings.validate("decor", "reduced")), false)
		T.eq((Settings.validate("decor", "off")), false)
		T.eq((Settings.validate("fx", true)), false)
		T.eq((Settings.validate("fx", "FULL")), false)
		T.eq((Settings.validate("fx", string.rep("x", 100))), false)
	end)
	T.it("KEYS lists every accepted key; get() falls back to full", function()
		for _, k in { "hints", "avatarLook", "hintGems", "fx", "decor" } do
			T.truthy(table.find(Settings.KEYS, k), k)
		end
		T.eq(Settings.get({}, "fx"), "full")
		T.eq(Settings.get(nil, "decor"), "full")
		T.eq(Settings.get({ fx = "off" }, "fx"), "off")
		T.eq(Settings.get({ fx = "bogus" }, "fx"), "full")
		T.eq(Settings.get({ decor = "low" }, "decor"), "low")
	end)
	T.it("(iteration 7) shake / castSfx = full | low | off; full is stored as nil; saved", function()
		for _, k in { "shake", "castSfx" } do
			T.eq(select(2, Settings.validate(k, "low")), "low")
			T.eq(select(2, Settings.validate(k, "off")), "off")
			local ok, v = Settings.validate(k, "full")
			T.eq(ok, true)
			T.eq(v, nil)
			T.eq((Settings.validate(k, "reduced")), false)
			T.eq((Settings.validate(k, true)), false)
			T.eq(Settings.get({}, k), "full")
			T.truthy(table.find(Settings.KEYS, k))
		end
		local p = ProfileSchema.migrate({ settings = { shake = "off", castSfx = "low" } })
		T.eq(p.settings.shake, "off")
		T.eq(p.settings.castSfx, "low")
	end)
	T.it("string settings survive the profile migration", function()
		local p = ProfileSchema.migrate({ settings = { fx = "reduced", decor = "low", hints = true } })
		T.eq(p.settings.fx, "reduced")
		T.eq(p.settings.decor, "low")
		T.eq(p.settings.hints, true)
	end)
end)

return T.finish()
