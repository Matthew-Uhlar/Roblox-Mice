--!strict
-- Data/Settings (iter 5 #3): SetSetting keys and values (saved graphics settings).
local T = require("../lib/Test")
local Settings = require("../../src/shared/Data/Settings")
local ProfileSchema = require("../../src/shared/Data/ProfileSchema")

T.describe("Data/Settings", function()
	T.it("boolean keys take booleans only", function()
		T.eq(select(2, Settings.validate("hints", true)), true)
		T.eq((Settings.validate("hints", false)), true)
		T.eq((Settings.validate("hints", "full")), false)
		T.eq((Settings.validate("music", 1)), false)
		T.eq((Settings.validate("notAKey", true)), false)
		T.eq((Settings.validate(nil, true)), false)
	end)
	T.it("fx = full | reduced | off; decor = full | low; full is stored as nil", function()
		local ok, v = Settings.validate("fx", "reduced")
		T.eq(ok, true)
		T.eq(v, "reduced")
		T.eq(select(2, Settings.validate("fx", "off")), "off")
		ok, v = Settings.validate("fx", "full")
		T.eq(ok, true)
		T.eq(v, nil, "default -> nil")
		T.eq(select(2, Settings.validate("decor", "low")), "low")
		T.eq((Settings.validate("decor", "reduced")), false)
		T.eq((Settings.validate("decor", "off")), false)
		T.eq((Settings.validate("fx", true)), false)
		T.eq((Settings.validate("fx", "FULL")), false)
		T.eq((Settings.validate("fx", string.rep("x", 100))), false)
	end)
	T.it("KEYS lists every accepted key; get() falls back to full", function()
		for _, k in { "hints", "avatarLook", "hintGems", "fx", "decor" } do
			T.truthy(table.find(Settings.KEYS, k), k)
		end
		T.eq(Settings.get({}, "fx"), "full")
		T.eq(Settings.get(nil, "decor"), "full")
		T.eq(Settings.get({ fx = "off" }, "fx"), "off")
		T.eq(Settings.get({ fx = "bogus" }, "fx"), "full")
		T.eq(Settings.get({ decor = "low" }, "decor"), "low")
	end)
	T.it("(iteration 7) shake / castSfx = full | low | off; full is stored as nil; saved", function()
		for _, k in { "shake", "castSfx" } do
			T.eq(select(2, Settings.validate(k, "low")), "low")
			T.eq(select(2, Settings.validate(k, "off")), "off")
			local ok, v = Settings.validate(k, "full")
			T.eq(ok, true)
			T.eq(v, nil)
			T.eq((Settings.validate(k, "reduced")), false)
			T.eq((Settings.validate(k, true)), false)
			T.eq(Settings.get({}, k), "full")
			T.truthy(table.find(Settings.KEYS, k))
		end
		local p = ProfileSchema.migrate({ settings = { shake = "off", castSfx = "low" } })
		T.eq(p.settings.shake, "off")
		T.eq(p.settings.castSfx, "low")
	end)
	-- iteration 7 (team Mesh): Models: Detailed (meshes) / Classic (part models)
	T.it("(iteration 7) models = detailed | classic; detailed is stored as nil; saved", function()
		T.eq(select(2, Settings.validate("models", "classic")), "classic")
		local ok, v = Settings.validate("models", "detailed")
		T.eq(ok, true)
		T.eq(v, nil)
		T.eq((Settings.validate("models", "full")), false)
		T.eq((Settings.validate("models", true)), false)
		T.eq(Settings.get({}, "models"), "detailed")
		T.eq(Settings.get({ models = "classic" }, "models"), "classic")
		T.truthy(table.find(Settings.KEYS, "models"))
		local p = ProfileSchema.migrate({ settings = { models = "classic" } })
		T.eq(p.settings.models, "classic")
	end)
	-- iteration 7 (team Client): Ability casting: Quick / Hold to aim
	T.it("(iteration 7) castMode = quick | hold; quick is stored as nil; saved", function()
		T.eq(select(2, Settings.validate("castMode", "hold")), "hold")
		local ok, v = Settings.validate("castMode", "quick")
		T.truthy(ok)
		T.eq(v, nil)
		T.eq((Settings.validate("castMode", "full")), false)
		T.eq((Settings.validate("castMode", true)), false)
		T.eq(Settings.get({}, "castMode"), "quick")
		T.eq(Settings.get({ castMode = "hold" }, "castMode"), "hold")
		T.truthy(table.find(Settings.KEYS, "castMode"))
		local p = ProfileSchema.migrate({ settings = { castMode = "hold" } })
		T.eq(p.settings.castMode, "hold")
	end)
	-- iteration 8 (team Client): keybinds as a compact string
	T.it("(iteration 8) binds: compact string, defaults stored as nil, no key twice", function()
		T.truthy(#Settings.BIND_KEYS <= #Settings.BIND_ALPHABET)
		T.truthy(#Settings.DEFAULT_BINDS <= 64, "fits the profile's 64-char strings")
		local def = Settings.decodeBinds(nil)
		T.eq(def.ability1, "Space")
		T.eq(def.runShop, "V")
		T.eq(def.camNorth, "N")
		local ok, v = Settings.validate("binds", Settings.DEFAULT_BINDS)
		T.truthy(ok)
		T.eq(v, nil)
		local custom = Settings.encodeBinds({ ability2 = "F1", ping = "H" }) :: string
		T.truthy(Settings.validBinds(custom))
		T.eq(select(2, Settings.validate("binds", custom)), custom)
		local back = Settings.decodeBinds(custom)
		T.eq(back.ability2, "F1")
		T.eq(back.ping, "H")
		T.eq(back.ability1, "Space")
		T.eq(Settings.encodeBinds({ ability1 = "Nope" }), nil)
		-- duplicates, junk, wrong version, too long
		T.falsy(Settings.validBinds(Settings.encodeBinds({ ability2 = "Space" })))
		T.falsy(Settings.validBinds("1~"))
		T.falsy(Settings.validBinds("2" .. string.sub(Settings.DEFAULT_BINDS, 2)))
		T.falsy(Settings.validBinds(Settings.DEFAULT_BINDS .. "z"))
		T.falsy(Settings.validBinds(42))
		T.eq((Settings.validate("binds", "x")), false)
		-- a shorter (older) string keeps the defaults for later actions
		T.eq(Settings.decodeBinds("1" .. "1").ability1, "Q")
		T.eq(Settings.decodeBinds("11").camNorth, "N")
		T.truthy(table.find(Settings.KEYS, "binds"))
		local p = ProfileSchema.migrate({ settings = { binds = custom } })
		T.eq(p.settings.binds, custom)
	end)
	T.it("string settings survive the profile migration", function()
		local p = ProfileSchema.migrate({ settings = { fx = "reduced", decor = "low", hints = true } })
		T.eq(p.settings.fx, "reduced")
		T.eq(p.settings.decor, "low")
		T.eq(p.settings.hints, true)
	end)
end)

return T.finish()
