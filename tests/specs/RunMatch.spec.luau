--!strict
-- Run/MatchState: the v2 squad layer (GDD-v2 §1–2).
local T = require("../lib/Test")
local MatchState = require("../../src/shared/Run/MatchState")
local RunState = require("../../src/shared/Run/RunState")
local Ids = require("../../src/shared/Util/Ids")
local Squads = require("../../src/shared/Util/Squads")

local C = MatchState.CONFIG

-- Squad s, seat k (1..3): humans in squad 1 by default (ids 1, 2, 3 when asked).
local function bot(n: number): number
	return Ids.botId(n)
end

-- Default lobby: squad 1 = human 1 + 2 bots, squads 2–4 = 3 bots each.
local function lobby(humansInSquad1: number?): { any }
	local list = {}
	local h = humansInSquad1 or 1
	local nBot = 0
	for s = 1, 4 do
		for seat = 1, 3 do
			if s == 1 and seat <= h then
				table.insert(list, { id = seat, squad = s, isBot = false })
			else
				nBot += 1
				table.insert(list, { id = bot(nBot), squad = s, isBot = true })
			end
		end
	end
	return list
end

-- One human per squad (ids 1..4), the rest bots.
local function oneHumanEach(): { any }
	local list = {}
	local nBot = 0
	for s = 1, 4 do
		table.insert(list, { id = s, squad = s })
		for _ = 1, 2 do
			nBot += 1
			table.insert(list, { id = bot(nBot), squad = s })
		end
	end
	return list
end

local function newMatch(seed: number?, list: { any }?): any
	local m = MatchState.new(seed or 1, list or lobby())
	m:begin()
	return m
end

local function dmg(a: number, b: number, c: number, d: number): { [number]: number }
	return { [1] = a, [2] = b, [3] = c, [4] = d }
end

-- Boss phase + clear: killer squad k (nil = timeout) with damage table.
local function clear(m: any, killer: number?, damage: any?): any
	m:startBoss()
	return m:bossDefeated(killer, damage or dmg(10, 5, 5, 5))
end

-- Route pick by the winner (default card) + extraction choices.
local function advance(m: any, choices: { [number]: string }?): any
	local cards = m:routeCards()
	m:chooseRoute(MatchState.defaultRouteIndex(cards), m:routeChooser())
	return m:resolveExtraction(choices or {})
end

local function expectedChest(m: any, stage: number): number
	local route = m:currentRoute()
	return RunState.applyPressureCheese(
		RunState.stageCheese(1, stage, route.rewardMult, false),
		m:pressurePoints()
	)
end

T.describe("MatchState.new", function()
	T.it("seats 12 participants into 4 squads with names and colours", function()
		local m = MatchState.new(1, lobby())
		T.eq(m.phase, "Lobby")
		for s = 1, 4 do
			local sq = m:squad(s)
			T.eq(#sq.members, 3, "squad " .. s)
			T.eq(sq.name, Squads.LIST[s].name)
			T.deepEq(sq.color, Squads.LIST[s].color)
		end
		T.eq(m:squadOf(1), 1)
		T.eq(m:member(bot(9)).isBot, true)
		T.eq(m:member(1).isBot, false)
		T.eq(m:humansInRun(), 1, "seated humans count once squads exist")
	end)
	T.it("isBot defaults from the id band (Studio players -1..-8 are humans)", function()
		local m = MatchState.new(1, { { id = -1, squad = 1 }, { id = bot(1), squad = 1 } })
		T.eq(m:member(-1).isBot, false)
		T.eq(m:member(bot(1)).isBot, true)
	end)
	T.it("rejects bad squads, duplicates and over-full squads", function()
		T.truthy(not pcall(MatchState.new, 1, { { id = 1, squad = 5 } }), "squad 5")
		T.truthy(not pcall(MatchState.new, 1, { { id = 1, squad = 1 }, { id = 1, squad = 2 } }), "dup")
		local four = {}
		for i = 1, 4 do
			table.insert(four, { id = i, squad = 1 })
		end
		T.truthy(not pcall(MatchState.new, 1, four), "4 in one squad")
	end)
	T.it("empty squads are never in the run", function()
		local m = newMatch(1, { { id = 1, squad = 2 }, { id = bot(1), squad = 3 } })
		T.deepEq(m:squadsInRun(), { 2, 3 })
		T.eq(m:squad(1).empty, true)
	end)
	T.it("wrong-phase calls raise errors", function()
		local m = MatchState.new(1, lobby())
		T.truthy(not pcall(m.startBoss, m), "startBoss in Lobby")
		m:begin()
		T.truthy(not pcall(m.begin, m), "begin twice")
		T.truthy(not pcall(m.bossDefeated, m, 1, {}), "bossDefeated in Waves")
		T.truthy(not pcall(m.resolveExtraction, m, {}), "resolveExtraction in Waves")
	end)
end)

T.describe("MatchState stage loop", function()
	T.it("begin starts stage 1 on a Low card; the first blessing goes to every squad", function()
		local m = MatchState.new(3, lobby())
		local card = m:begin()
		T.eq(m.phase, "Waves")
		T.eq(m.stage, 1)
		T.eq(card.tier, "Low")
		clear(m, 1)
		if card.blessingId then
			for s = 1, 4 do
				T.deepEq(m:blessingsFor(s), { card.blessingId }, "squad " .. s)
			end
		end
	end)
	T.it(
		"a stage clear pays every squad in the run; the winner gets the chest and picks the route",
		function()
			local m = newMatch(5)
			local chest = expectedChest(m, 1)
			local r = clear(m, 2)
			T.eq(r.winner, 2)
			T.eq(r.winnerBy, "kill")
			T.eq(r.stageCheese, chest)
			T.eq(r.chestCheese, chest)
			T.eq(m.phase, "RouteChoice")
			T.eq(m:routeChooser(), 2)
			T.eq(#m:routeCards(), 3)
			T.eq(m:shareOf(1), chest, "loser squad member")
			T.eq(m:shareOf(bot(3)), chest * 2, "winner squad member (squad 2 seat 1)")
			T.eq(m:squadPending(2), chest * 2 * 3)
			T.eq(m:member(1).xp, r.xp)
			T.truthy(r.xp > 0)
		end
	)
	T.it("the winner's route blessing goes to the winner only", function()
		local m = newMatch(8)
		clear(m, 3)
		local cards = m:routeCards()
		local idx = 3 -- High card
		local blessing = cards[idx].blessingId
		m:chooseRoute(idx, 3)
		T.eq(m.phase, "Extraction")
		m:resolveExtraction({})
		T.eq(m.stage, 2)
		local before1 = #m:blessingsFor(1)
		local before3 = #m:blessingsFor(3)
		clear(m, 1)
		if blessing then
			T.eq(#m:blessingsFor(3), before3 + 1, "chooser gets the blessing")
			T.eq(#m:blessingsFor(1), before1, "others do not")
		end
	end)
	T.it("4 stages, then every survivor extracts automatically", function()
		local m = newMatch(9)
		for stage = 1, 3 do
			clear(m, 1)
			advance(m)
			T.eq(m.stage, stage + 1)
		end
		T.truthy(m:isFinalStage())
		local share = m:shareOf(1)
		local r = clear(m, 1)
		T.eq(r.finished, true)
		T.eq(r.endReason, "final")
		T.eq(m.phase, "Results")
		T.eq(#r.out, 12, "all 12 take their pot home")
		local p = m:payout(1)
		T.eq(p.result, "extracted")
		T.eq(p.cheese, share + r.stageCheese + r.chestCheese)
		T.eq(p.xp, m:member(1).xp)
		T.eq(m:extractedCount(), 4)
	end)
	T.it("curses and Pressure stay world-wide on the shared RunState", function()
		local m = MatchState.new(4, lobby(), { pressure = { thick_rind = 1 } })
		m:begin()
		T.truthy(type(m:worldMods()) == "table")
		local chest = expectedChest(m, 1)
		local r = clear(m, 1)
		T.eq(r.stageCheese, chest, "Pressure bonus in the stage chest")
		T.eq(m:pressurePoints(), m.run:pressurePoints())
	end)
end)

T.describe("MatchState boss winner", function()
	T.it("the killing blow wins", function()
		local m = newMatch(1)
		m:startBoss()
		T.eq((m:bossWinner(4, dmg(100, 0, 0, 1))), 4)
	end)
	T.it("a timeout goes to the top damage squad", function()
		local m = newMatch(1)
		local r = clear(m, nil, dmg(5, 50, 20, 0))
		T.eq(r.winner, 2)
		T.eq(r.winnerBy, "damage")
	end)
	T.it("a killer squad that is out of the run falls back to damage", function()
		local m = newMatch(1)
		m:eliminateSquad(4)
		local r = clear(m, 4, dmg(5, 1, 30, 99))
		T.eq(r.winner, 3, "squad 4 is out; squad 3 dealt the most among the rest")
	end)
	T.it("damage ties are broken by the match rng, deterministically", function()
		local winners = {}
		for seed = 1, 30 do
			local m = newMatch(seed)
			local r = clear(m, nil, dmg(40, 40, 10, 40))
			T.truthy(r.winner == 1 or r.winner == 2 or r.winner == 4, "a tied squad wins")
			winners[r.winner] = true
			local again = newMatch(seed)
			T.eq(clear(again, nil, dmg(40, 40, 10, 40)).winner, r.winner, "same seed, same winner")
		end
		local n = 0
		for _ in winners do
			n += 1
		end
		T.truthy(n >= 2, "ties do not always go to the same squad")
	end)
	T.it("no damage at all: no winner, no chest, the default route", function()
		local m = newMatch(1)
		local r = clear(m, nil, {})
		T.eq(r.winner, nil)
		T.eq(r.chestCheese, 0)
		T.eq(m:routeChooser(), nil)
		T.eq(m:shareOf(1), r.stageCheese)
	end)
	T.it("accepts string squad keys in damageBySquad", function()
		local m = newMatch(1)
		local r = clear(m, nil, { ["3"] = 12, ["1"] = 4 })
		T.eq(r.winner, 3)
	end)
end)

T.describe("MatchState extraction window", function()
	T.it("Extract banks 100% and leaves; Stay keeps going; missing or bad choice = Stay", function()
		local m = newMatch(2)
		clear(m, 1)
		local share2 = m:shareOf(bot(3))
		local cards = m:routeCards()
		m:chooseRoute(1, 1)
		local res = m:resolveExtraction({ [2] = "Extract", [3] = "Stay", [4] = "Banana" :: any })
		T.deepEq(res.extracted, { 2 })
		T.deepEq(res.stayed, { 1, 3, 4 })
		T.eq(#res.out, 3)
		T.eq(m.phase, "Waves")
		T.eq(m.stage, 2)
		local p = m:payout(bot(3))
		T.eq(p.result, "extracted")
		T.eq(p.cheese, share2)
		T.eq(m:shareOf(bot(3)), 0)
		T.falsy(m:isInRun(bot(3)))
		T.truthy(m:isOut(bot(3)))
		T.truthy(cards ~= nil)
	end)
	T.it("extraction mid-run: the extracted payout is final; the rest keep playing", function()
		local m = newMatch(2, oneHumanEach())
		clear(m, 1)
		advance(m, { [1] = "Extract" })
		local paid = m:payout(1).cheese
		clear(m, 2)
		advance(m)
		clear(m, 2)
		advance(m)
		clear(m, 2)
		T.eq(m.phase, "Results")
		T.eq(m:payout(1).cheese, paid, "unchanged after extracting")
		T.eq(m:payout(1).result, "extracted")
		T.truthy(m:payout(2).cheese > paid, "the squad that stayed earned more")
	end)
	T.it("Portal Charm style extract multiplier", function()
		local m = newMatch(2)
		clear(m, 1)
		m:setExtractMult(1, 1.15)
		m:setExtractMult(2, 99) -- unknown id: ignored
		local share = m:shareOf(1)
		advance(m, { [1] = "Extract" })
		T.eq(m:payout(1).cheese, math.floor(share * 1.15 + 1e-6))
	end)
	T.it("every squad extracting ends the match (allOut)", function()
		local m = newMatch(2)
		clear(m, 1)
		local res = advance(m, { [1] = "Extract", [2] = "Extract", [3] = "Extract", [4] = "Extract" })
		T.eq(res.finished, true)
		T.eq(res.endReason, "allOut")
		T.eq(m.phase, "Results")
		T.eq(#res.out, 12)
	end)
	T.it("Double or Nothing: pot x1.5 at the next clear", function()
		local m = newMatch(2)
		clear(m, 1)
		local share = m:shareOf(1)
		advance(m, { [1] = "DoubleOrNothing" })
		T.truthy(m:squadDoubleOrNothing(1))
		local r = clear(m, 3)
		T.eq(m:shareOf(1), math.floor(share * 1.5 + 1e-6) + r.stageCheese)
		T.truthy(r.potBonus[1] > 0)
		T.falsy(m:squadDoubleOrNothing(1), "DoN clears after the stage")
	end)
	T.it("Double or Nothing loss: eliminated on the DoN stage banks nothing", function()
		local m = newMatch(2)
		clear(m, 1)
		local xp = m:member(1).xp
		advance(m, { [1] = "DoubleOrNothing", [2] = "Stay" })
		local res = m:eliminateSquad(1)
		T.eq(#res.out, 3)
		T.eq(m:payout(1).cheese, 0)
		T.eq(m:payout(1).result, "eliminated")
		T.eq(m:payout(1).xp, xp, "XP is never lost")
		-- a non-DoN squad keeps half
		local share2 = m:shareOf(bot(3))
		m:eliminateSquad(2)
		local bag = math.floor(share2 * C.LOOT_BAG_FRAC + 1e-6)
		T.eq(m:payout(bot(3)).cheese, math.floor((share2 - bag) * 0.5 + 1e-6))
	end)
	T.it("brave bonus: +25% stage cheese once 2 squads have extracted", function()
		local m = newMatch(2)
		clear(m, 1)
		advance(m, { [3] = "Extract", [4] = "Extract" })
		T.eq(m:extractedCount(), 2)
		local route = m:currentRoute()
		local base = RunState.stageCheese(1, 2, route.rewardMult, false)
		local r = clear(m, 1, dmg(1, 0, 0, 0))
		T.eq(r.brave, true)
		T.eq(r.stageCheese, math.floor(base * 1.25 + 1e-6))
	end)
	T.it("no brave bonus with only 1 squad extracted", function()
		local m = newMatch(2)
		clear(m, 1)
		advance(m, { [4] = "Extract" })
		T.eq(clear(m, 1).brave, false)
	end)
end)

T.describe("MatchState elimination and Last Herd Standing", function()
	T.it("elimination mid-stage: bags drop, half the rest is kept, squad is out", function()
		local m = newMatch(6)
		clear(m, 2)
		advance(m)
		local share = m:shareOf(bot(3))
		local res = m:eliminateSquad(2)
		T.eq(#res.out, 3)
		T.eq(#res.drops, 3, "every member drops a bag")
		local bag = math.floor(share * C.LOOT_BAG_FRAC + 1e-6)
		T.eq(res.drops[1].cheese, bag)
		T.eq(m:payout(bot(3)).cheese, math.floor((share - bag) * C.ELIMINATED_KEEP_FRAC + 1e-6))
		T.falsy(m:isSquadInRun(2))
		T.deepEq(m:squadsInRun(), { 1, 3, 4 })
		T.eq(#m:eliminateSquad(2).out, 0, "idempotent")
		T.eq(m:squad(2).eliminated, true)
	end)
	T.it("a member killed earlier does not drop a second bag at elimination", function()
		local m = newMatch(6)
		clear(m, 2)
		advance(m)
		local k = m:heroKilled(bot(3), 1)
		T.truthy(k.bagCheese > 0)
		local res = m:eliminateSquad(2)
		T.eq(#res.drops, 2)
	end)
	T.it("simultaneous eliminations of everyone end the match", function()
		local m = newMatch(6)
		for s = 1, 4 do
			m:eliminateSquad(s)
		end
		T.eq(m.phase, "Results")
		T.eq(m.endReason, "allOut")
	end)
	T.it("last squad standing for 2 stages: +50% pot and extracted", function()
		local m = newMatch(7)
		m:eliminateSquad(2)
		m:eliminateSquad(3)
		m:eliminateSquad(4)
		T.deepEq(m:squadsInRun(), { 1 })
		local r1 = clear(m, 1)
		T.eq(r1.finished, false)
		T.eq(m.aloneStages, 1)
		advance(m, { [1] = "Stay" })
		local share = m:shareOf(1)
		local r2 = clear(m, 1)
		T.eq(r2.finished, true)
		T.eq(r2.endReason, "lastHerd")
		local p = m:payout(1)
		T.eq(p.result, "lastHerd")
		T.eq(p.lastHerd, true)
		T.eq(p.extracted, true)
		T.eq(p.cheese, math.floor((share + r2.stageCheese + r2.chestCheese) * 1.5 + 1e-6))
		T.eq(m.stage, 2, "ended before stage 4")
	end)
	T.it("alone stages reset if another squad was still in the run", function()
		local m = newMatch(7)
		m:eliminateSquad(3)
		m:eliminateSquad(4)
		clear(m, 1)
		T.eq(m.aloneStages, 0)
		advance(m)
		m:eliminateSquad(2)
		clear(m, 1)
		T.eq(m.aloneStages, 1)
		T.eq(m.phase, "RouteChoice")
	end)
	T.it("alone for stages 3 and 4: the final clear pays Last Herd Standing", function()
		local m = newMatch(7)
		clear(m, 1)
		advance(m)
		clear(m, 1)
		advance(m, { [2] = "Extract", [3] = "Extract" })
		m:eliminateSquad(4)
		clear(m, 1)
		T.eq(m.aloneStages, 1)
		advance(m)
		local r = clear(m, 1)
		T.eq(r.endReason, "lastHerd")
		T.eq(m:payout(1).result, "lastHerd")
		T.eq(r.brave, true, "2 squads extracted: brave too")
	end)
end)

T.describe("MatchState loot bags", function()
	T.it("a killed hero drops 30% of their share; the picker's squad splits it", function()
		local m = newMatch(11)
		clear(m, 1)
		advance(m)
		local share = m:shareOf(1)
		local k = m:heroKilled(1, bot(3))
		T.eq(k.bagCheese, math.floor(share * 0.3 + 1e-6))
		T.eq(m:shareOf(1), share - k.bagCheese)
		T.eq(k.killerSquad, 2)
		T.eq(k.victimSquad, 1)
		m:registerBag(5001, k.bagKey)
		local before = { m:shareOf(bot(3)), m:shareOf(bot(4)), m:shareOf(bot(5)) }
		local moved = m:claimBag(5001, bot(4))
		T.eq(moved, k.bagCheese)
		local gained = m:shareOf(bot(3))
			- before[1]
			+ m:shareOf(bot(4))
			- before[2]
			+ m:shareOf(bot(5))
			- before[3]
		T.eq(gained, k.bagCheese, "all of it lands in squad 2")
		local each = math.floor(k.bagCheese / 3)
		T.truthy(m:shareOf(bot(4)) - before[2] >= each, "the picker gets at least an even share")
		T.eq(m:claimBag(5001, bot(4)), 0, "a bag is claimed once")
		T.eq(m:claimBag(9999, bot(4)), 0, "unknown bag")
	end)
	T.it("a hero only drops one bag per stage; respawn next stage clears it", function()
		local m = newMatch(11)
		clear(m, 1)
		advance(m)
		T.truthy(m:heroKilled(1, bot(3)) ~= nil)
		T.eq(m:heroKilled(1, bot(3)), nil, "already dead")
		clear(m, 1)
		advance(m)
		T.falsy(m:member(1).dead, "respawned")
		T.truthy(m:heroKilled(1, bot(3)).bagCheese > 0, "drops again on a later stage")
	end)
	T.it("unclaimed bags are lost when the next stage starts", function()
		local m = newMatch(11)
		clear(m, 1)
		advance(m)
		local k = m:heroKilled(1, bot(3))
		T.eq(m:unclaimedBagCheese(), k.bagCheese)
		clear(m, 2)
		advance(m)
		T.eq(m:unclaimedBagCheese(), 0)
		T.eq(m:claimBag(k.bagKey, bot(3)), 0)
	end)
	T.it("a picker who is out of the run cannot claim", function()
		local m = newMatch(11)
		clear(m, 1)
		advance(m)
		local k = m:heroKilled(1, bot(3))
		m:eliminateSquad(3)
		T.eq(m:claimBag(k.bagKey, bot(6)), 0)
		T.truthy(m:claimBag(k.bagKey, bot(3)) > 0, "still claimable by a squad in the run")
	end)
end)

T.describe("MatchState kills and bounties", function()
	T.it("3 kills in a row give a bounty; downing them pays +100 to the downer", function()
		local m = newMatch(12)
		local killer = bot(3) -- squad 2
		T.eq(m:heroKilled(bot(1), killer).newBounty, nil)
		T.eq(m:heroKilled(bot(6), killer).newBounty, nil)
		local k3 = m:heroKilled(bot(9), killer)
		T.eq(k3.newBounty, killer)
		T.deepEq(m:bountyIds(), { killer })
		T.eq(m:member(killer).kills, 3)
		T.eq(m:squad(2).kills, 3)
		local before = m:shareOf(1)
		local d = m:heroDowned(killer, 1)
		T.eq(d.bounty.cheese, C.BOUNTY_CHEESE)
		T.eq(d.bounty.by, 1)
		T.eq(m:shareOf(1), before + 100)
		T.deepEq(m:bountyIds(), {})
		T.eq(m:member(killer).streak, 0)
		T.eq(m:member(1).downs, 1)
	end)
	T.it("downed by mice (no attacker) keeps the bounty; a teammate never claims it", function()
		local m = newMatch(12)
		local killer = bot(3)
		for _, v in { bot(1), bot(6), bot(9) } do
			m:heroKilled(v, killer)
		end
		T.eq(m:heroDowned(killer, nil).bounty, nil)
		T.eq(m:heroDowned(killer, bot(4)).bounty, nil, "same squad")
		T.deepEq(m:bountyIds(), { killer })
	end)
	T.it("killing a bountied hero also claims it; dying resets the streak", function()
		local m = newMatch(12)
		local killer = bot(3)
		for _, v in { bot(1), bot(6), bot(9) } do
			m:heroKilled(v, killer)
		end
		local k = m:heroKilled(killer, 1)
		T.eq(k.bounty.cheese, 100)
		T.eq(m:member(killer).streak, 0)
		T.falsy(m:member(killer).bounty)
	end)
	T.it("kills by mice or teammates are not PvP kills", function()
		local m = newMatch(12)
		local k = m:heroKilled(bot(1), nil)
		T.eq(k.killer, nil)
		T.eq(m:squad(1).kills, 0)
		local k2 = m:heroKilled(bot(2), 1)
		T.eq(k2.killer, nil, "same squad: no credit")
	end)
	T.it("unknown ids are ignored", function()
		local m = newMatch(12)
		T.eq(m:heroKilled(777, 1), nil)
		T.eq(m:heroDowned(777, 1), nil)
		T.eq(m:removeMember(777), nil)
	end)
end)

T.describe("MatchState disconnects", function()
	T.it("a leaver keeps half their share; the squad plays on with its bots", function()
		local m = newMatch(13)
		clear(m, 1)
		advance(m)
		local share = m:shareOf(1)
		local p = m:removeMember(1)
		T.eq(p.result, "left")
		T.eq(p.cheese, math.floor(share * 0.5 + 1e-6))
		T.truthy(m:isSquadInRun(1), "bots keep squad 1 alive")
		T.eq(m:humansInRun(), 0)
		T.eq(m:removeMember(1), nil, "once")
	end)
	T.it("leaving on a Double-or-Nothing stage keeps nothing", function()
		local m = newMatch(13)
		clear(m, 1)
		advance(m, { [1] = "DoubleOrNothing" })
		T.eq(m:removeMember(1).cheese, 0)
	end)
	T.it("a squad whose members all left is out; the last ones in the run continue", function()
		local m = newMatch(13, { { id = 1, squad = 1 }, { id = 2, squad = 2 }, { id = 3, squad = 2 } })
		m:removeMember(1)
		T.falsy(m:isSquadInRun(1))
		T.eq(m:squad(1).outReason, "left")
		T.eq(m.phase, "Waves")
		m:removeMember(2)
		m:removeMember(3)
		T.eq(m.phase, "Results")
	end)
	T.it("leaving after extracting keeps the extracted payout", function()
		local m = newMatch(13)
		clear(m, 1)
		local share = m:shareOf(1)
		advance(m, { [1] = "Extract" })
		T.eq(m:removeMember(1).cheese, share)
		T.eq(m:payout(1).result, "extracted")
	end)
	T.it("no humans left: finish('noHumans') ends the bot squads unpaid", function()
		local m = newMatch(13)
		m:removeMember(1)
		T.eq(m:humansInRun(), 0)
		local out = m:finish("noHumans")
		T.eq(#out, 11)
		T.eq(m.phase, "Results")
		T.eq(m:payout(bot(1)).result, "unfinished")
	end)
	T.it("finish('crash') pays the wipe rule to everyone still in the run", function()
		local m = newMatch(13)
		clear(m, 1)
		advance(m)
		local share = m:shareOf(1)
		m:finish("crash")
		T.eq(m:payout(1).cheese, math.floor(share * 0.5 + 1e-6))
		T.eq(m:payout(1).result, "aborted")
		T.eq(#m:finish("crash"), 0, "once")
	end)
end)

T.describe("MatchState payouts and views", function()
	T.it("final payouts per participant; bots are listed but RunDirector skips them", function()
		local m = newMatch(14, oneHumanEach())
		clear(m, 1)
		advance(m, { [2] = "Extract" })
		m:eliminateSquad(3)
		clear(m, 1)
		advance(m)
		clear(m, 4)
		advance(m)
		clear(m, 1)
		local list = m:payouts()
		T.eq(#list, 12)
		local by = {}
		for _, p in list do
			by[p.id] = p
		end
		T.eq(by[1].result, "extracted")
		T.eq(by[2].result, "extracted")
		T.eq(by[3].result, "eliminated")
		T.eq(by[4].result, "extracted")
		T.truthy(by[1].cheese > by[2].cheese, "staying longer paid more")
		T.eq(by[1].summary.stagesSurvived, 4)
		T.eq(by[2].summary.stagesSurvived, 1)
		T.eq(by[1].summary.extracted, true)
		T.eq(by[3].summary.extracted, false)
	end)
	T.it("class XP summary and fallback", function()
		local m = newMatch(14)
		m:notePoi(1)
		m:notePoi(1)
		m:heroDowned(bot(3), 1)
		clear(m, 1, dmg(30, 10, 0, 0))
		local s = m:summary(1)
		T.eq(s.pois, 2)
		T.eq(s.heroDowns, 1)
		T.near(s.bossDamageShare, 0.25, 1e-9, "squad share 0.75 split over 3 members")
		T.eq(s.stagesSurvived, 1)
		local xp = MatchState.classXpFallback(s)
		T.eq(xp, math.floor(40 + 25 + 15 + 20))
		s.extracted = true
		T.eq(MatchState.classXpFallback(s), math.floor((40 + 25 + 15 + 20) * 1.5))
	end)
	T.it("a dead member of a surviving squad gets the stage pay but not 'survived'", function()
		local m = newMatch(14)
		m:heroKilled(1, bot(3))
		local before = m:shareOf(1)
		local r = clear(m, 2)
		T.eq(m:shareOf(1), before + r.stageCheese)
		T.eq(m:summary(1).stagesSurvived, 0)
	end)
	T.it("difficulty is the average squad weight", function()
		local m = MatchState.new(1, lobby(3))
		-- squad 1: 3 humans = 3; squads 2–4: 3 bots = 1.8 each -> (3 + 5.4) / 4 = 2.1
		T.near(m:difficulty(), 2.1)
		m:begin()
		m:eliminateSquad(1)
		T.near(m:difficulty(), 1.8)
	end)
	T.it("getPublic: 4 squads, isYou, the viewer's block, routeChooser only while choosing", function()
		local m = newMatch(15)
		local pub = m:getPublic(1)
		T.eq(#pub.squads, 4)
		T.eq(pub.stage, 1)
		T.eq(pub.stages, 4)
		T.eq(pub.squads[1].isYou, true)
		T.eq(pub.squads[2].isYou, false)
		T.eq(pub.squads[1].alive, true)
		T.eq(pub.squads[1].aliveCount, 3)
		T.eq(#pub.squads[1].members, 3)
		T.eq(pub.you.squad, 1)
		T.eq(pub.routeChooser, nil)
		clear(m, 3)
		pub = m:getPublic(1)
		T.eq(pub.routeChooser, 3)
		T.eq(pub.squads[3].pending, m:squadPending(3))
		T.eq(m:getPublic().you, nil, "no viewer")
		m:heroKilled(1, bot(3))
		T.eq(m:getPublic(1).squads[1].aliveCount, 2)
		T.eq(
			m:getPublic(1, function()
				return true
			end).squads[1].aliveCount,
			3,
			"custom alive check"
		)
	end)
	T.it("addSquadCheese / addMemberCheese only reach members in the run", function()
		local m = newMatch(16)
		T.eq(m:addSquadCheese(1, 10), 30)
		T.eq(m:addMemberCheese(1, 5.7), 5)
		T.eq(m:addMemberCheese(1, -3), 0)
		T.eq(m:addMemberCheese(1, 0 / 0), 0)
		m:eliminateSquad(1)
		T.eq(m:addSquadCheese(1, 10), 0)
		T.eq(m:addMemberCheese(1, 10), 0)
	end)
	T.it("spendShare pays from the share only, never past it (Shop Cart)", function()
		local m = newMatch(16)
		m:addMemberCheese(1, 100)
		T.eq(m:spendShare(1, 150), false)
		T.eq(m:shareOf(1), 100)
		T.eq(m:spendShare(1, 60), true)
		T.eq(m:shareOf(1), 40)
		T.eq(m:spendShare(1, 0 / 0), false)
		m:refundShare(1, 60)
		T.eq(m:shareOf(1), 100)
		m:eliminateSquad(1)
		T.eq(m:spendShare(1, 1), false, "out of the run")
	end)
	T.it("botExtractChoice: mostly Stay early, never Double or Nothing", function()
		local Rng = require("../../src/shared/Util/Rng")
		local m = newMatch(17)
		local rng = Rng.new(3)
		local extracts = 0
		for _ = 1, 200 do
			local c = m:botExtractChoice(2, rng)
			T.truthy(c == "Extract" or c == "Stay", c)
			if c == "Extract" then
				extracts += 1
			end
		end
		T.truthy(extracts > 0 and extracts < 60, "stage 1 extracts: " .. extracts)
	end)
	T.it("stagesCleared counts clears while in the run", function()
		local m = newMatch(16)
		clear(m, 1)
		advance(m, { [2] = "Extract" })
		clear(m, 1)
		T.eq(m:payout(1).stagesCleared, 2)
		T.eq(m:payout(bot(3)).stagesCleared, 1)
	end)
	T.it("fallenSquads: nobody standing = fallen; unknown members never count", function()
		local m = newMatch(19)
		clear(m, 1)
		m:chooseRoute(1, 1)
		-- squad 1 all down, squad 2 one standing, squad 3 unknown (no heroes), squad 4 dead + down
		local down: { [number]: boolean? } = {
			[1] = false,
			[bot(1)] = false,
			[bot(2)] = false,
			[bot(3)] = false,
			[bot(4)] = true,
			[bot(5)] = false,
			[bot(9)] = false,
			[bot(10)] = false,
		}
		m:heroKilled(bot(11), nil) -- squad 4's third member is dead (MatchState)
		local fallen = m:fallenSquads(function(id)
			return down[id]
		end)
		T.deepEq(fallen, { 1, 4 })
	end)
	T.it("[regression] a squad with nobody standing at the gate is eliminated, never extracted", function()
		local m = newMatch(20)
		clear(m, 1)
		local share = m:shareOf(1)
		m:chooseRoute(1, 1)
		for _, s in
			m:fallenSquads(function(id)
				return m:squadOf(id) ~= 1 -- squad 1 all downed
			end)
		do
			m:eliminateSquad(s)
		end
		local res = m:resolveExtraction({ [1] = "Extract", [2] = "Extract" })
		T.deepEq(res.extracted, { 2 })
		local p = m:payout(1)
		T.eq(p.result, "eliminated")
		T.falsy(p.extracted)
		T.truthy(p.cheese < share, "no 100% bank: " .. p.cheese .. " vs share " .. share)
		T.eq(m:squad(1).outReason, "eliminated")
	end)
	T.it("payout.stage is the stage the squad left at, stagesCleared unchanged", function()
		local m = newMatch(21)
		clear(m, 1)
		advance(m) -- everyone stays: stage 2
		clear(m, 1)
		advance(m, { [1] = "Extract" }) -- squad 1 extracts after stage 2
		T.eq(m.stage, 3, "the match moved on to stage 3")
		local p = m:payout(1)
		T.eq(p.stage, 2, "Results stage")
		T.eq(p.stagesCleared, 2)
		T.eq(m:payout(bot(3)).stage, 3, "a squad still in the run: the current stage")
		m:eliminateSquad(2)
		T.eq(m:payout(bot(3)).stage, 3, "eliminated on stage 3")
	end)
	T.it("placement: Last Herd first, then how far, extracted above eliminated", function()
		local m = newMatch(18)
		clear(m, 1)
		advance(m, { [4] = "Extract" })
		m:eliminateSquad(3) -- eliminated on stage 2
		m:eliminateSquad(2) -- eliminated on stage 2
		T.eq(m:placement(1), 1, "still playing")
		T.eq(m:placement(4), 4, "extracted at stage 1 ranks below squads eliminated later")
		clear(m, 1)
		advance(m)
		local r = clear(m, 1)
		T.eq(r.endReason, "lastHerd")
		T.eq(m:payout(1).placement, 1)
		T.truthy(m:placement(2) == 2 or m:placement(2) == 3)
		T.truthy(m:placement(2) ~= m:placement(3), "no shared places")
	end)
	T.it("placement: extracted beats eliminated at the same stage", function()
		local m = newMatch(18)
		clear(m, 1)
		advance(m) -- stage 2
		m:eliminateSquad(4) -- out on stage 2
		clear(m, 1)
		advance(m, { [3] = "Extract" }) -- out after stage 2
		T.eq(m:squad(3).outAtStage, m:squad(4).outAtStage)
		T.truthy(m:placement(3) < m:placement(4), "extracted above eliminated")
		T.truthy(m:placement(1) < m:placement(3), "still playing above both")
	end)
	T.it("is deterministic for a seed", function()
		local function play(seed: number): string
			local m = newMatch(seed)
			local out = {}
			for _ = 1, 3 do
				local r = clear(m, nil, dmg(1, 1, 1, 1))
				table.insert(out, tostring(r.winner))
				advance(m)
			end
			return table.concat(out, ",") .. "|" .. tostring(m:currentRoute().mapId)
		end
		T.eq(play(77), play(77))
	end)
end)

return T.finish()
