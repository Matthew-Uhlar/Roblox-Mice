local T = require("../lib/Test")
local Rng = require("../../src/shared/Util/Rng")
local Vote = require("../../src/shared/Run/Vote")
local Ids = require("../../src/shared/Util/Ids")

T.describe("Vote", function()
	T.it("counts votes per option, including zeros", function()
		local v = Vote.new(3, { 1, 2, 3 })
		T.truthy(v:cast(1, 2))
		T.truthy(v:cast(2, 2))
		T.truthy(v:cast(3, 3))
		T.deepEq(v:tally(), { 0, 2, 1 })
		T.eq(v:resolve(Rng.new(1)), 2)
	end)
	T.it("rejects non-voters and invalid options", function()
		local v = Vote.new(3, { 10 })
		T.falsy(v:cast(99, 1), "not a voter")
		T.falsy(v:cast(10, 0))
		T.falsy(v:cast(10, 4))
		T.falsy(v:cast(10, 1.5))
		T.falsy(v:cast(10, 0 / 0))
		T.falsy(v:cast(10, math.huge))
		T.falsy(v:cast(10, "1" :: any))
		T.deepEq(v:tally(), { 0, 0, 0 })
	end)
	T.it("lets a voter change their vote (last one counts)", function()
		local v = Vote.new(2, { 1 })
		v:cast(1, 1)
		v:cast(1, 2)
		T.deepEq(v:tally(), { 0, 1 })
	end)
	T.it("allVoted tracks every voter", function()
		local v = Vote.new(2, { 1, 2 })
		T.falsy(v:allVoted())
		v:cast(1, 1)
		T.falsy(v:allVoted())
		v:cast(2, 2)
		T.truthy(v:allVoted())
	end)
	T.it("with no voters allVoted is true and resolve returns the default", function()
		local v = Vote.new(3, {})
		T.truthy(v:allVoted())
		T.eq(v:resolve(Rng.new(1)), 1)
		T.eq(v:resolve(Rng.new(1), 2), 2)
	end)
	T.it("nobody voting resolves to the default (Low = 1)", function()
		local v = Vote.new(3, { 1, 2, 3, 4 })
		T.eq(v:resolve(Rng.new(1)), 1)
		T.eq(v:resolve(Rng.new(1), 3), 3)
	end)
	T.it("clamps an out-of-range default", function()
		local v = Vote.new(2, { 1 })
		T.eq(v:resolve(Rng.new(1), 9), 2)
		T.eq(v:resolve(Rng.new(1), -1), 1)
	end)
	T.it("breaks ties at random between the tied options only", function()
		local seen = {}
		for seed = 1, 200 do
			local v = Vote.new(3, { 1, 2, 3, 4 })
			v:cast(1, 1)
			v:cast(2, 1)
			v:cast(3, 3)
			v:cast(4, 3)
			local r = v:resolve(Rng.new(seed))
			T.truthy(r == 1 or r == 3, "picked " .. r)
			seen[r] = true
		end
		T.truthy(seen[1] and seen[3], "both tied options should win sometimes")
	end)
	T.it("tie-break is deterministic for a seed", function()
		local function run(seed: number): number
			local v = Vote.new(2, { 1, 2 })
			v:cast(1, 1)
			v:cast(2, 2)
			return v:resolve(Rng.new(seed))
		end
		T.eq(run(42), run(42))
	end)
	T.it("a single vote beats no votes", function()
		local v = Vote.new(3, { 1, 2, 3 })
		v:cast(2, 3)
		T.eq(v:resolve(Rng.new(1)), 3)
	end)
	T.it("removeVoter drops the player and their vote", function()
		local v = Vote.new(2, { 1, 2 })
		v:cast(1, 2)
		v:removeVoter(1)
		T.deepEq(v:tally(), { 0, 0 })
		T.falsy(v:cast(1, 1))
		T.falsy(v:allVoted())
		v:cast(2, 1)
		T.truthy(v:allVoted())
	end)
	T.it("accepts bot voters with negative ids", function()
		local v = Vote.new(3, { 12345, -1, -2 })
		T.truthy(v:cast(-1, 3))
		T.truthy(v:cast(-2, 3))
		T.truthy(v:cast(12345, 1))
		T.falsy(v:cast(-3, 1))
		T.eq(v:resolve(Rng.new(1)), 3)
		T.truthy(v:allVoted())
	end)
	T.it("rejects an optionCount below 1", function()
		T.throws(function()
			Vote.new(0, { 1 })
		end)
	end)
end)

T.describe("Vote › risky options need a human vote (QC2 M3)", function()
	local BOT1, BOT2 = Ids.botId(1), Ids.botId(2)
	local opts = { "Continue", "DoubleOrNothing" }
	T.it("riskyIndices finds Double or Nothing and Next Cycle only", function()
		T.deepEq(Vote.riskyIndices(opts), { 2 })
		T.deepEq(Vote.riskyIndices({ "GoHome", "NextCycle" }), { 2 })
		T.deepEq(Vote.riskyIndices({ { tier = "High" }, "Continue" }), {})
	end)
	T.it("two bot votes for Double or Nothing cannot beat an idle human: default wins", function()
		local v = Vote.new(2, { 1, BOT1, BOT2 })
		v:cast(BOT1, 2)
		v:cast(BOT2, 2)
		for seed = 1, 20 do
			T.eq(v:resolve(Rng.new(seed), 1, Vote.riskyIndices(opts)), 1)
		end
		-- without the guard the bots would have carried it (old behaviour)
		T.eq(v:resolve(Rng.new(1), 1), 2)
	end)
	T.it("a bot split (Continue vs DoN) with no human vote resolves to Continue every time", function()
		local v = Vote.new(2, { 1, BOT1, BOT2 })
		v:cast(BOT1, 1)
		v:cast(BOT2, 2)
		for seed = 1, 50 do
			T.eq(v:resolve(Rng.new(seed), 1, { 2 }), 1)
		end
	end)
	T.it("one human Double or Nothing vote makes it eligible", function()
		local v = Vote.new(2, { 1, BOT1, BOT2 })
		v:cast(1, 2)
		v:cast(BOT1, 2)
		v:cast(BOT2, 1)
		T.eq(v:humanVotes(2), 1)
		T.eq(v:resolve(Rng.new(1), 1, { 2 }), 2)
	end)
	T.it("Studio test players (-1, -2) are humans, not bots", function()
		local v = Vote.new(2, { -1, BOT1 })
		v:cast(-1, 2)
		T.eq(v:humanVotes(2), 1)
		T.eq(v:resolve(Rng.new(1), 1, { 2 }), 2)
	end)
end)

return T.finish()
