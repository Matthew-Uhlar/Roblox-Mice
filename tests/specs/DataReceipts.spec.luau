local T = require("../lib/Test")
local ProfileSchema = require("../../src/shared/Data/ProfileSchema")
local Receipts = require("../../src/shared/Data/Receipts")
local Monetization = require("../../src/shared/Config/Monetization")

local CTX = { now = 1_000_000, day = 11 }

T.describe("Receipts.apply", function()
	T.it("grants a Golden Cheese pack and records the PurchaseId", function()
		local p = ProfileSchema.default()
		local status, r = Receipts.apply(p, "pid-1", "golden_m", CTX)
		T.eq(status, "granted")
		T.eq(r.goldenCheese, 550)
		T.eq(p.goldenCheese, 550)
		T.truthy(p.purchaseHistory["pid-1"])
		T.eq(p.purchaseOrder[1], "pid-1")
	end)
	T.it("is idempotent by PurchaseId", function()
		local p = ProfileSchema.default()
		Receipts.apply(p, "pid-1", "golden_xl", CTX)
		local status = Receipts.apply(p, "pid-1", "golden_xl", CTX)
		T.eq(status, "duplicate")
		T.eq(p.goldenCheese, 2400)
		-- a duplicate id with a different product still grants nothing
		T.eq(Receipts.apply(p, "pid-1", "second_wind_3", CTX), "duplicate")
		T.eq(p.secondWindTokens, 0)
		T.eq(#p.purchaseOrder, 1)
	end)
	T.it("stays idempotent across a save/load (migrate) round trip", function()
		local p = ProfileSchema.default()
		Receipts.apply(p, "pid-9", "second_wind_1", CTX)
		local loaded = ProfileSchema.migrate(ProfileSchema.deepCopy(p))
		T.eq(Receipts.apply(loaded, "pid-9", "second_wind_1", CTX), "duplicate")
		T.eq(loaded.secondWindTokens, 1)
	end)
	T.it("rejects unknown products, passes, bad ids and bad ctx without changes", function()
		local p = ProfileSchema.default()
		local before = ProfileSchema.deepCopy(p)
		T.eq(Receipts.apply(p, "a", "robux_printer", CTX), "rejected")
		T.eq(Receipts.apply(p, "b", "vip", CTX), "rejected")
		T.eq(Receipts.apply(p, "c", "cheese_club", CTX), "rejected")
		T.eq(Receipts.apply(p, "", "golden_xs", CTX), "rejected")
		T.eq(Receipts.apply(p, 42, "golden_xs", CTX), "rejected")
		T.eq(Receipts.apply(p, "d", "golden_xs", {} :: any), "rejected")
		T.deepEq(p, before)
	end)
	T.it("prunes history to the cap but keeps recent ids idempotent", function()
		local p = ProfileSchema.default()
		local max = Monetization.RULES.purchaseHistoryMax
		for i = 1, max + 50 do
			T.eq(Receipts.apply(p, "id" .. i, "golden_xs", CTX), "granted")
		end
		T.eq(#p.purchaseOrder, max)
		T.eq(p.purchaseHistory.id1, nil)
		T.eq(p.purchaseOrder[1], "id51")
		local gold = p.goldenCheese
		for i = 51, max + 50 do
			T.eq(Receipts.apply(p, "id" .. i, "golden_xs", CTX), "duplicate")
		end
		T.eq(p.goldenCheese, gold)
		local n = 0
		for _ in p.purchaseHistory do
			n += 1
		end
		T.eq(n, max, "map and order stay in sync")
	end)
	T.it("Second Wind packs ignore the cheese-shop holding cap", function()
		local p = ProfileSchema.default()
		p.secondWindTokens = 10
		Receipts.apply(p, "sw", "second_wind_3", CTX)
		T.eq(p.secondWindTokens, 13)
	end)
	T.it("Cheese Rush extends time, capped at 24h", function()
		local p = ProfileSchema.default()
		Receipts.apply(p, "r1", "cheese_rush", CTX)
		T.eq(p.boosts.cheese2xUntil, CTX.now + 3600)
		Receipts.apply(p, "r2", "cheese_rush", CTX)
		T.eq(p.boosts.cheese2xUntil, CTX.now + 7200)
		for i = 3, 40 do
			Receipts.apply(p, "r" .. i, "cheese_rush", CTX)
		end
		T.eq(p.boosts.cheese2xUntil, CTX.now + 24 * 3600)
		-- an expired boost restarts from now
		local q = ProfileSchema.default()
		q.boosts.cheese2xUntil = 5
		Receipts.apply(q, "x", "cheese_rush", CTX)
		T.eq(q.boosts.cheese2xUntil, CTX.now + 3600)
	end)
	T.it("Cheese Feast is stored as pending on the profile", function()
		local p = ProfileSchema.default()
		local _, r = Receipts.apply(p, "f1", "cheese_feast", CTX)
		T.truthy(r.feast)
		T.eq(p.boosts.feastPending, 1)
	end)
	T.it("ad reward gives +50% of the last run once, then the minimum, and counts per day", function()
		local p = ProfileSchema.default()
		p.lastRun = { cheese = 400, adClaimed = false }
		local _, r = Receipts.apply(p, "ad1", "ad_reward", CTX)
		T.eq(r.cheese, 200)
		local _, r2 = Receipts.apply(p, "ad2", "ad_reward", CTX)
		T.eq(r2.cheese, Monetization.RULES.adBonusMin)
		T.eq(p.ads.count, 2)
		p.lastRun = { cheese = 100000, adClaimed = false }
		local _, r3 = Receipts.apply(p, "ad3", "ad_reward", { now = CTX.now, day = CTX.day + 1 })
		T.eq(r3.cheese, Monetization.RULES.adBonusMax)
		T.eq(p.ads.count, 1, "counter resets on a new day")
	end)
end)

T.describe("Receipts.applyPass", function()
	T.it("grants pass cosmetics idempotently", function()
		local p = ProfileSchema.default()
		T.truthy(Receipts.applyPass(p, "vip"))
		T.truthy(p.cosmetics.trail_golden_tusk and p.cosmetics.hat_vip_crown)
		T.falsy(Receipts.applyPass(p, "vip"), "second apply changes nothing")
	end)
	T.it("Founders unlocks every class", function()
		local p = ProfileSchema.default()
		Receipts.applyPass(p, "founders")
		for _, id in { "elephante", "le_fante", "filet", "jumbo", "fizzante" } do
			T.truthy(p.unlockedClasses[id], id)
		end
		T.truthy(p.cosmetics.hat_founder)
	end)
	T.it("ignores products and unknown keys", function()
		local p = ProfileSchema.default()
		T.falsy(Receipts.applyPass(p, "golden_xs"))
		T.falsy(Receipts.applyPass(p, "nope"))
	end)
end)

T.describe("Receipts.applyClubMonthly", function()
	T.it("grants one fixed cosmetic per month, kept forever", function()
		local p = ProfileSchema.default()
		local a = Receipts.applyClubMonthly(p, 24321)
		T.truthy(a and p.cosmetics[a])
		T.eq(Receipts.applyClubMonthly(p, 24321), nil, "once per month")
		local b = Receipts.applyClubMonthly(p, 24322)
		T.truthy(b and b ~= a)
		Receipts.applyClubMonthly(p, 24323)
		local gold = p.goldenCheese
		T.eq(Receipts.applyClubMonthly(p, 24324), nil, "owns all -> fixed fallback")
		T.eq(p.goldenCheese, gold + 300)
	end)
end)

return T.finish()
