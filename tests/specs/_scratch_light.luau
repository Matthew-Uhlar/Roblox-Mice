local Runtime = require("../runtime/Runtime")
local roblox = require("@lune/roblox")
local rt = Runtime.new({ root = ".", dt = 1 / 30 })
rt:startServer()
rt:advance(2)
local L = rt.game:GetService("Lighting")
print(L.Technology, L.LightingStyle, L.PrioritizeLightingQuality)
print(pcall(function() L.Technology = roblox.Enum.Technology.Voxel end))
print(pcall(function() return rt.workspace.Terrain.Decoration end))
print(pcall(function() rt.workspace.Terrain:FillBlock(roblox.CFrame.new(), roblox.Vector3.new(4,4,4), roblox.Enum.Material.Plastic) end))
print(pcall(function() rt.workspace.Terrain:SetMaterialColor(roblox.Enum.Material.Water, roblox.Color3.new()) end))
print(rt.workspace.Terrain:GetMaterialColor(roblox.Enum.Material.Grass))
local ts = rt:terrainStats() print(ts.fills, ts.solidMin, ts.solidMax, ts.airMin, ts.airMax, ts.maxVoxels)
for k,v in ts.byMethod do print(k,v) end
print("gaps", #rt:gaps(), "errors", #rt:errors()) print(rt:report())
